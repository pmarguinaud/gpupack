+ export DR_HOOK_OPT=prof
+ DR_HOOK_OPT=prof
+ export EC_PROFILE_HEAP=0
+ EC_PROFILE_HEAP=0
+ export EC_MPI_ATEXIT=0
+ EC_MPI_ATEXIT=0
+ export MKL_CBWR=AUTO,STRICT
+ MKL_CBWR=AUTO,STRICT
+ export MKL_DEBUG_CPU_TYPE=5
+ MKL_DEBUG_CPU_TYPE=5
+ export MKL_NUM_THREADS=1
+ MKL_NUM_THREADS=1
